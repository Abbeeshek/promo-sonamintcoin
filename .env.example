# Sona Mint Coin Promotional Hub - Server & OAuth Environment Variables
# Copy to .env and populate real provider credentials for production deployment

# YouTube (Google OAuth 2.0 & YouTube Data API v3)
VITE_YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
VITE_YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# LinkedIn (LinkedIn OAuth 2.0 & Community Management API)
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
VITE_LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# TikTok (TikTok Content Posting API v2)
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
VITE_TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Instagram (Meta Graph API v18.0)
VITE_INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Facebook (Meta Graph API v18.0)
VITE_FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
VITE_FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
